# ===== Obligatorio =====
# Clave de Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Clave para entrar a la app: mínimo 12 caracteres (mejor 16+, con letras, números y símbolos).
# Sin ella DELTA no arranca.
CLAVE_ACCESO=

# ===== Opcional =====
NOMBRE_USUARIO=
ZONA_HORARIA=America/Mexico_City
HORA_RESUMEN=08:00
# DELTA_MODELO=claude-opus-5-5
# DELTA_ESFUERZO=medium

# ===== Gmail (ver README, "Conectar Gmail") =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: solo aceptar esta cuenta de Gmail
GMAIL_CUENTA=
# Opcional: dirección pública de DELTA si Google no la detecta bien (ej. https://delta-studio-production.up.railway.app)
URL_PUBLICA=

# Hotmail / Outlook.com (Microsoft): vea "Conectar Hotmail" en el README
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# OUTLOOK_CUENTA=su@hotmail.com

# ===== WhatsApp (WhatsApp Cloud API de Meta) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# "Secreto de la app" (Meta → tu app → Configuración → Básica). Sin él, DELTA ignora WhatsApp.
WHATSAPP_APP_SECRET=
# Tu número personal con código de país, sin + ni espacios (ej. 5215512345678)
WHATSAPP_MI_NUMERO=
# Plantilla aprobada para avisos cuando no le has escrito a DELTA en 24 h
WHATSAPP_PLANTILLA=recordatorio_delta
WHATSAPP_PLANTILLA_IDIOMA=es_MX

# ===== Voz natural de DELTA (ElevenLabs, ver README "Voz natural") =====
# Sin esta clave DELTA usa la voz del equipo. La voz se crea y se borra desde Ajustes.
ELEVENLABS_API_KEY=
# Opcional: usar una voz ya creada en ElevenLabs en lugar de crearla desde Ajustes
ELEVENLABS_VOZ_ID=
# Opcional: eleven_multilingual_v2 (la más natural) o eleven_flash_v2_5 (más rápida y gasta la mitad)
# ELEVENLABS_MODELO=eleven_multilingual_v2

# ===== Higgsfield: imágenes y videos con IA para el departamento de Diseño (ver README "Diseño") =====
# Se crean en https://console.higgsfield.ai → API keys. Son dos datos: el Key ID y el Secret.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Opcional: tope diario para cuidar el gasto
# HIGGSFIELD_IMAGENES_DIA=20
# HIGGSFIELD_VIDEOS_DIA=4
# Opcional: modelos (ver docs.higgsfield.ai)
# HIGGSFIELD_MODELO_IMAGEN=higgsfield-ai/soul/standard
# HIGGSFIELD_MODELO_VIDEO=kling-video/v3.0/pro
